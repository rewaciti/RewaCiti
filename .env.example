# Everything here ends up in the website's public JavaScript, so never put a
# secret (sk_) key in it.

# SabiFlow's API
VITE_API_URL=https://api.sabiflow.com/api

# RewaCiti's company id, for customer sign-in (/customers/*)
VITE_COMPANY_ID=

# SabiFlow → Real Estate → API: a public key (pk_live_…) with the website's
# addresses as its allowed websites. A pk_test_ key checks every request the
# same way but saves nothing, for trying the site out.
VITE_SABIFLOW_PUBLIC_KEY=
